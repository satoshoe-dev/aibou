{
    "id": "aibou",
    "name": "Aibou",
    "description": "Control Center tile and settings for Aibou, small companions that live behind your windows",
    "version": "1.0.0",
    "author": "satoshoe",
    "license": "MIT",
    "type": "composite",
    "capabilities": [
        "control-center",
        "daemon"
    ],
    "components": {
        "widget": "./AibouWidget.qml",
        "daemon": "./AibouSurfaces.qml"
    },
    "settings": "./AibouSettings.qml",
    "icon": "mood",
    "requires_dms": ">=1.6.1",
    "dependencies": [
        "aibou"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
